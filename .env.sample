# ==============================================================================
# omnic environment configuration sample
# Copy this file to .env and adjust values for your local setup.
# ==============================================================================

# Network & Server
# Listen address for HTTP API & /emu routes (default ":8080")
OMNIC_ADDR=:8080

# Listen address for pprof profiling and Prometheus /metrics (default "localhost:6060")
OMNIC_PPROF=localhost:6060

# Protocol engines to enable: twilio, whatsapp, telegram, or all (default "twilio")
OMNIC_ENGINES=twilio

# Enable human-readable colored development logging (zap)
OMNIC_DEV=false

# Pre-seed demo phone numbers on startup (default false)
OMNIC_SEED=false

# Print version and exit on startup (default false)
OMNIC_VERSION=false

# Storage
# Path to SQLite database file. Leave empty to use fast in-memory storage.
OMNIC_DB=

# Simulated carrier / transit delay (e.g. 50ms, 200ms, 1s)
OMNIC_DELIVERY_DELAY=50ms

# Dynamic Failure Injection Rules (semicolon or comma-separated)
# Examples:
#   send=429:20429@after 5
#   send=400:30007@to +15550009999
#   webhook=timeout
OMNIC_FAIL_RULES=

# ==============================================================================
# Twilio Engine Configuration
# ==============================================================================

# Secret auth token used for Twilio HMAC-SHA1 X-Twilio-Signature validation
OMNIC_TWILIO_AUTH_TOKEN=authtoken

# Default upstream URL where inbound Twilio SMS messages are forwarded as signed webhooks
OMNIC_TWILIO_UPSTREAM_URL=http://127.0.0.1:8000/api/sms/inbound

# HTTP method for Twilio upstream webhook forwarding (POST or GET)
OMNIC_TWILIO_UPSTREAM_METHOD=POST

# Pre-provisioned Twilio accounts: AC<hex>:TOKEN (comma-separated for multiple accounts)
OMNIC_TWILIO_ACCOUNTS=AC000000000000000000000000000001:authtoken

# Pre-provisioned Twilio phone numbers: +E164[@AC...] (comma-separated for multiple numbers)
OMNIC_TWILIO_NUMBERS=+14155550199@AC00000000000000000000000000000001

# ==============================================================================
# WhatsApp Cloud API Engine Configuration
# ==============================================================================

# Meta WhatsApp Phone Number ID
OMNIC_WHATSAPP_PHONE_ID=100000000000001

# Meta WhatsApp Business Account ID (WABA ID)
OMNIC_WHATSAPP_WABA_ID=200000000000001

# Bearer access token for WhatsApp Graph API calls
OMNIC_WHATSAPP_TOKEN=wa_token_dev

# Webhook verification challenge token (hub.verify_token)
OMNIC_WHATSAPP_VERIFY_TOKEN=wa_verify_token

# App secret for Meta HMAC-SHA256 X-Hub-Signature-256 webhook signatures
OMNIC_WHATSAPP_SECRET=wa_secret_dev

# Dedicated webhook URL where inbound WhatsApp messages are forwarded (falls back to OMNIC_TWILIO_UPSTREAM_URL if unset)
OMNIC_WHATSAPP_UPSTREAM_URL=

# ==============================================================================
# Telegram Bot API Engine Configuration
# ==============================================================================

# Mock Telegram Bot token required in URL paths /bot<token>/... (default "123456789:mock_token_dev")
OMNIC_TELEGRAM_BOT_TOKEN=123456789:mock_token_dev

# Bot username returned by getMe (default "omnic_bot")
OMNIC_TELEGRAM_BOT_USERNAME=omnic_bot

# Friendly bot display name (default "OmnicBot")
OMNIC_TELEGRAM_BOT_NAME=OmnicBot

# Dedicated webhook URL where inbound Telegram updates are forwarded
OMNIC_TELEGRAM_UPSTREAM_URL=

# Secret token expected in X-Telegram-Bot-Api-Secret-Token header
OMNIC_TELEGRAM_SECRET_TOKEN=

# Simulated network delivery latency for Telegram updates (default 20ms)
OMNIC_TELEGRAM_DELIVERY_DELAY=20ms

# ==============================================================================
# Handset Client Configuration (omnic-handset)
# ==============================================================================

# Handset protocol engine mode: twilio, whatsapp, telegram, or all (default "all")
OMPHONE_ENGINE=all

# omnic server base URL (default "http://localhost:8080")
OMPHONE_SERVER=http://localhost:8080

# Sender phone number (default "+14155551111")
OMPHONE_FROM=+14155551111

# Recipient phone number (default "+14155550199")
OMPHONE_TO=+14155550199

# Telegram chat ID representing handset user (default 14155551111)
OMPHONE_TELEGRAM_CHAT_ID=14155551111

# Telegram username of handset participant (default "handset_user")
OMPHONE_TELEGRAM_USERNAME=handset_user

# Audio capture device ID or name (default "default")
OMPHONE_AUDIO_IN=default

# Audio playback device ID or name (default "default")
OMPHONE_AUDIO_OUT=default
